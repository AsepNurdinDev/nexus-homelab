# Copy this file to .env and set a strong, unique password.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

# Keep Grafana bound to localhost for a safer initial setup.
# Cloudflare Tunnel running on the host can reach http://127.0.0.1:3002.
GRAFANA_BIND_ADDRESS=127.0.0.1
GRAFANA_PORT=3002
PROMETHEUS_PORT=9090
