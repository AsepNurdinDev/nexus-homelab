cat > .gitignore <<'EOF'
# Environment & secrets
.env
.env.*
!.env.example
*.pem
*.key
*.crt
secrets/
credentials/

# Terraform
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Ansible
.vault_password
*.retry

# Docker
docker-compose.override.yml

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/

# Temporary files
*.tmp
*.swp
*.swo
*~
EOF